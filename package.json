    "@radix-ui/react-toast": "1.2.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@t3-oss/env-nextjs": "0.13.11",
    "@upstash/redis": "1.38.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "12.17.1",
    "firebase-admin": "14.2.0",
    "lucide-react": "1.32.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
